    function filterGrocery() {
      const query = document.getElementById('grocerySearchInput').value.toLowerCase().trim();
      const allGrocery = products.filter(p => p.category === 'grocery');
      const filtered = allGrocery.filter(item => item.name.toLowerCase().includes(query));
      renderGrocery(filtered);
    }

    function addToCart(productId) {
      const prod = products.find(p => p.id === productId);
      if (!prod || !prod.inStock) return;
      const existing = cart.find(i => i.id === productId);
      if (existing) {
        existing.qty += 1;
        existing.price = prod.price;
      } else {
        cart.push({ id: prod.id, name: prod.name, price: prod.price, emoji: prod.emoji || '🛒', qty: 1 });
      }
      saveCartState();
      updateCartUI();
    }

    function changeQty(productId, delta) {
      const item = cart.find(i => i.id === productId);
      if (!item) return;
      item.qty += delta;
      if (item.qty <= 0) cart = cart.filter(i => i.id !== productId);
      saveCartState();
      updateCartUI();
    }

    function saveCartState() {
      try { localStorage.setItem('hh_cart', JSON.stringify(cart)); } catch (e) {}
    }

    function updateCartUI() {
      const totalCount = cart.reduce((s, i) => s + i.qty, 0);
      const totalPrice = cart.reduce((s, i) => s + (i.price * i.qty), 0);
      
      document.getElementById('cartBadgeCount').innerText = totalCount;
      document.getElementById('drawerItemCountText').innerText = `${totalCount} صنف محدد`;
      document.getElementById('cartGrandTotal').innerText = `${totalPrice} ج.م`;

      const list = document.getElementById('cartItemsList');
      if (cart.length === 0) {
        list.innerHTML = `<div class="text-center py-12 text-stone-400 text-xs">سلة الطلبات فارغة حالياً</div>`;
        return;
      }
      list.innerHTML = cart.map(item => `
        <div class="flex items-center justify-between p-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs">
          <div class="flex items-center gap-2">
            <span class="text-xl">${esc(item.emoji)}</span>
            <div>
              <p class="font-bold text-stone-900">${esc(item.name)}</p>
              <span class="text-[11px] text-stone-500">${esc(item.price)} ج.م</span>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="changeQty('${esc(item.id)}', -1)" class="w-6 h-6 bg-white border border-stone-300 rounded-md font-bold">-</button>
            <span class="font-bold w-4 text-center">${esc(item.qty)}</span>
            <button onclick="changeQty('${esc(item.id)}', 1)" class="w-6 h-6 bg-white border border-stone-300 rounded-md font-bold">+</button>
            <span class="font-black text-amber-800 pr-1">${esc(item.price * item.qty)} ج.م</span>
          </div>
        </div>
      `).join('');
    }

    function toggleCartDrawer() {
      const overlay = document.getElementById('cartDrawerOverlay');
      overlay.classList.toggle('hidden');
      if (!overlay.classList.contains('hidden')) overlay.classList.add('flex');
      else overlay.classList.remove('flex');
    }

    function toggleAdminLoginModal(show = null) {
      const modal = document.getElementById('adminLoginModal');
      const shouldShow = show === null ? modal.classList.contains('hidden') : show;
      if (shouldShow) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => document.getElementById('adminPinInput').focus(), 100);
      } else {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.getElementById('adminPinError').classList.add('hidden');
        document.getElementById('adminPinInput').value = '';
      }
    }

    function handleAdminLogin(e) {
      e.preventDefault();
      const enteredPin = document.getElementById('adminPinInput').value.trim();
      if (enteredPin === storeSettings.adminPin) {
        isAdminLoggedIn = true;
        sessionStorage.setItem('hh_is_admin', 'true');
        toggleAdminLoginModal(false);
        syncSettingsUI();
        renderDishes();
        renderGrocery();
        openAdminDashboard('products');
      } else {
        document.getElementById('adminPinError').classList.remove('hidden');
      }
    }

    function adminLogout() {
      isAdminLoggedIn = false;
      sessionStorage.removeItem('hh_is_admin');
      closeAdminDashboard();
      syncSettingsUI();
      renderDishes();
      renderGrocery();
    }

    function openAdminDashboard(defaultTab = 'products', preselectCategory = null) {
      if (!isAdminLoggedIn) { toggleAdminLoginModal(true); return; }
      const modal = document.getElementById('adminDashboardModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      switchAdminTab(defaultTab);
      renderAdminProductsTable();
      renderAdminPaymentsList();
      if (preselectCategory) document.getElementById('newProdCategory').value = preselectCategory;
    }

    function closeAdminDashboard() {
      const modal = document.getElementById('adminDashboardModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function switchAdminTab(tabName) {
      ['products', 'add', 'payments', 'settings'].forEach(t => {
        const btn = document.getElementById(`tabBtn-${t}`);
        const content = document.getElementById(`adminTabContent-${t}`);
        if (t === tabName) {
          btn.className = 'px-4 py-2 rounded-t-xl bg-white text-stone-900 border-t-2 border-amber-600 shadow-xs font-bold cursor-pointer';
          content.classList.remove('hidden');
        } else {
          btn.className = 'px-4 py-2 rounded-t-xl text-stone-500 hover:text-stone-900 font-bold cursor-pointer';
          content.classList.add('hidden');
        }
      });
    }

    function renderAdminProductsTable(items = null) {
      const list = items || (currentAdminFilter
        ? products.filter(p => p.name.toLowerCase().includes(currentAdminFilter))
        : products);
      document.getElementById('totalAdminItemsCount').innerText = products.length;
      const tbody = document.getElementById('adminProductsTableBody');
      tbody.innerHTML = list.map(p => `
        <tr class="hover:bg-amber-50/40 transition">
          <td class="p-3 font-bold text-stone-900 flex items-center gap-2">
            <span class="text-xl">${esc(p.emoji || '📦')}</span>
            <div>
              <p>${esc(p.name)}</p>
              <span class="text-[10px] text-stone-400">${esc(p.unit || '')}</span>
            </div>
          </td>
          <td class="p-3 text-stone-600">${p.category === 'dishes' ? '🥗 وجبات حمدي' : '🧀 بقالة وألبان'}</td>
          <td class="p-3">
            <div class="flex items-center gap-1">
              <input type="number" id="priceInput-${esc(p.id)}" value="${esc(p.price)}" class="w-20 border border-stone-300 rounded-lg px-2 py-1 font-mono font-bold text-stone-900 text-xs">
              <button onclick="saveSinglePrice('${esc(p.id)}')" class="bg-amber-600 hover:bg-amber-700 text-white px-2 py-1 rounded-lg font-bold text-[11px] transition cursor-pointer">حفظ</button>
            </div>
          </td>
          <td class="p-3">
            <button onclick="toggleProductStock('${esc(p.id)}')" class="px-2.5 py-1 rounded-full text-[10px] font-bold cursor-pointer ${p.inStock ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'}">
              ${p.inStock ? '✓ متوفر' : '✕ نفد'}
            </button>
          </td>
          <td class="p-3 text-center">
            <button onclick="deleteProduct('${esc(p.id)}')" class="text-red-600 hover:bg-red-50 px-2 py-1 rounded-lg text-xs font-bold transition cursor-pointer">حذف</button>
          </td>
        </tr>
      `).join('');
    }

    function filterAdminProductsTable() {
      currentAdminFilter = document.getElementById('adminSearchInput').value.toLowerCase().trim();
      renderAdminProductsTable();
    }

    function saveSinglePrice(productId) {
      const input = document.getElementById(`priceInput-${productId}`);
      const newPrice = parseFloat(input.value);
      if (isNaN(newPrice) || newPrice < 0) { alert('يرجى كتابة سعر صحيح!'); return; }
      const prod = products.find(p => p.id === productId);
      if (prod) {
        prod.price = newPrice;
        const cartItem = cart.find(i => i.id === productId);
        if (cartItem) cartItem.price = newPrice;
        saveProductsState();
        saveCartState();
        renderDishes();
        renderGrocery();
        updateCartUI();
        renderAdminProductsTable();
        alert(`تم تحديث سعر "${prod.name}" إلى ${newPrice} ج.م بنجاح!`);
      }
    }

    function quickEditPrice(productId) {
      const prod = products.find(p => p.id === productId);
      if (!prod) return;
      const current = prod.price;
      const promptVal = prompt(`أدخل السعر الجديد لـ "${prod.name}" (ج.م):`, current);
      if (promptVal !== null) {
        const parsed = parseFloat(promptVal);
        if (!isNaN(parsed) && parsed >= 0) {
          prod.price = parsed;
          const cartItem = cart.find(i => i.id === productId);
          if (cartItem) cartItem.price = parsed;
          saveProductsState();
          saveCartState();
          renderDishes();
          renderGrocery();
          updateCartUI();
          if (!document.getElementById('adminDashboardModal').classList.contains('hidden')) renderAdminProductsTable();
        }
      }
    }

    function toggleProductStock(productId) {
      const prod = products.find(p => p.id === productId);
      if (prod) {
        prod.inStock = !prod.inStock;
        saveProductsState();
        renderDishes();
        renderGrocery();
        renderAdminProductsTable();
      }
    }

    function deleteProduct(productId) {
      const prod = products.find(p => p.id === productId);
      if (!prod) return;
      if (confirm(`هل أنت متأكد من حذف "${prod.name}" نهائياً من الموقع؟`)) {
        products = products.filter(p => p.id !== productId);
        cart = cart.filter(i => i.id !== productId);
        saveProductsState();
        saveCartState();
        renderDishes();
        renderGrocery();
        renderAdminProductsTable();
        updateCartUI();
      }
    }

    function saveNewProductFromAdmin() {
      const name = document.getElementById('newProdName').value.trim();
      const price = parseFloat(document.getElementById('newProdPrice').value);
      const category = document.getElementById('newProdCategory').value;
      const unit = document.getElementById('newProdUnit').value.trim() || (category === 'dishes' ? 'طبق' : 'كيلو');
      const emoji = document.getElementById('newProdEmoji').value.trim() || '🥗';
      const desc = document.getElementById('newProdDesc').value.trim();

      if (!name) { alert('يرجى إدخال اسم السلعة!'); return; }
      if (isNaN(price) || price <= 0) { alert('يرجى إدخال سعر صحيح!'); return; }

      const newId = 'prod_' + Date.now();
      products.unshift({ id: newId, name, price, category, unit, emoji, desc, inStock: true });
      saveProductsState();

      document.getElementById('newProdName').value = '';
      document.getElementById('newProdPrice').value = '';
      document.getElementById('newProdDesc').value = '';

      renderDishes();
      renderGrocery();
      renderAdminProductsTable();
      switchAdminTab('products');
      alert(`تمت إضافة "${name}" بنجاح!`);
    }

    function resetAllProductsToDefaults() {
      if (confirm('هل تريد استعادة قائمة الأصناف والأسعار الأصلية كما كانت أول مرة؟')) {
        products = [...INITIAL_DISHES, ...INITIAL_GROCERY];
        saveProductsState();
        renderDishes();
        renderGrocery();
        renderAdminProductsTable();
        alert('تمت استعادة الأصناف والأسعار الأصلية بنجاح.');
      }
    }

    function saveProductsState() {
      try {
        localStorage.setItem('hh_products', JSON.stringify(products));
        localStorage.setItem('hh_version', DATA_VERSION);
      } catch (e) {}
    }

    function renderAdminPaymentsList() {
      const container = document.getElementById('adminPaymentMethodsList');
      container.innerHTML = paymentMethods.map((pm, idx) => `
        <div class="border border-stone-200 rounded-xl p-3 bg-stone-50 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-bold text-stone-900">${esc(pm.name)}</span>
            <label class="flex items-center gap-1.5 cursor-pointer text-[11px]">
              <input type="checkbox" id="pm_enabled_${idx}" ${pm.enabled ? 'checked' : ''} class="rounded text-amber-600">
              <span>مفعل للزبائن</span>
            </label>
          </div>
          <input type="text" id="pm_details_${idx}" value="${esc(pm.details)}" class="w-full border border-stone-300 rounded-lg px-2 py-1 text-xs" placeholder="بيانات التحويل أو رقم الحساب">
        </div>
      `).join('');
    }

    function savePaymentSettings() {
      paymentMethods.forEach((pm, idx) => {
        pm.enabled = document.getElementById(`pm_enabled_${idx}`).checked;
        pm.details = document.getElementById(`pm_details_${idx}`).value.trim();
      });
      try { localStorage.setItem('hh_payments', JSON.stringify(paymentMethods)); } catch (e) {}
      alert('تم حفظ طرق الدفع وبيانات التحويل بنجاح!');
    }

    function saveStoreSettingsFromAdmin() {
      const name = document.getElementById('settingStoreName').value.trim();
      const phone = document.getElementById('settingStorePhone').value.trim();
      const whatsapp = document.getElementById('settingWhatsappNumber').value.trim();
      const pin = document.getElementById('settingAdminPin').value.trim();

      if (!pin) { alert('رمز PIN لا يمكن أن يكون فارغاً!'); return; }

      storeSettings = {
        storeName: name || storeSettings.storeName,
        phone: phone || storeSettings.phone,
        whatsappNumber: whatsapp || storeSettings.whatsappNumber,
        adminPin: pin,
        domain: 'habashhamdi.com'
      };

      try { localStorage.setItem('hh_settings', JSON.stringify(storeSettings)); } catch (e) {}
      syncSettingsUI();
      alert('تم حفظ إعدادات المحل ورمز PIN الجديد بنجاح!');
    }

    function sendOrderViaWhatsApp() {
      if (cart.length === 0) { alert('برجاء إضافة سلع أو وجبات إلى السلة أولاً!'); return; }
      const name = document.getElementById('orderCustomerName').value.trim() || 'عميل المحل';
      const phone = document.getElementById('orderCustomerPhone').value.trim() || 'غير مسجل';
      const address = document.getElementById('orderCustomerAddress').value.trim() || 'استلام من المحل';
      const total = cart.reduce((s, i) => s + (i.price * i.qty), 0);

      let text = `*طلب جديد من موقع ${storeSettings.storeName}* 🥗🛒\n`;
      text += `🌐 ${storeSettings.domain}\n`;
      text += `الاسم: ${name}\n`;
      text += `الهاتف: ${phone}\n`;
      text += `العنوان: ${address}\n`;
      text += `-------------------------\n`;
      text += `*قائمة الطلبات:*\n`;
      cart.forEach((i, idx) => {
        text += `${idx + 1}. ${i.name} (العدد: ${i.qty}) = ${i.price * i.qty} ج.م\n`;
      });
      text += `-------------------------\n`;
      text += `*الإجمالي الكلي:* ${total} ج.م\n`;
      text += `شكراً لاختياركم ${storeSettings.storeName}! 🌟`;

      const url = `https://wa.me/${storeSettings.whatsappNumber}?text=${encodeURIComponent(text)}`;
      window.open(url, '_blank');

      setTimeout(() => {
        cart = [];
        saveCartState();
        updateCartUI();
        toggleCartDrawer();
      }, 800);
    }

    document.getElementById('cartDrawerOverlay').addEventListener('click', function(e) {
      if (e.target === this) toggleCartDrawer();
    });
    document.getElementById('adminLoginModal').addEventListener('click', function(e) {
      if (e.target === this) toggleAdminLoginModal(false);
    });
    document.getElementById('adminDashboardModal').addEventListener('click', function(e) {
      if (e.target === this) closeAdminDashboard();
    });

    syncSettingsUI();
    renderDishes();
    renderGrocery();
    updateCartUI();
    checkSecretUrlTrigger();
  </script>
</body>
</html>
